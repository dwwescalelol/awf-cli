{
  "name": "openawf",
  "displayName": "OpenAWF",
  "description": "Diagnostics and live preview for OpenAWF workflows and tasks, powered by awf lsp.",
  "version": "0.1.0",
  "publisher": "awf",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "awf.preview",
        "title": "Open Preview",
        "category": "AWF",
        "icon": "$(open-preview)"
      },
      {
        "command": "awf.restartServer",
        "title": "Restart Language Server",
        "category": "AWF"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "awf.preview",
          "when": "editorLangId == yaml || editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "awf.preview",
          "when": "editorLangId == yaml || editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "OpenAWF",
      "properties": {
        "awf.path": {
          "type": "string",
          "default": "awf",
          "description": "Path to the awf executable. The extension runs `awf lsp`."
        },
        "awf.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the awf language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.82.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0"
  }
}
