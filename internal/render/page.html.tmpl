<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="data:,">
<title>{{.Name}}{{with .Version}} {{.}}{{end}}</title>
<style>
:root {
  --bg: #f1f3f6;
  --surface: #ffffff;
  --sunken: #f6f7f9;
  --ink: #16202b;
  --ink-2: #3a4655;
  --muted: #5d6877;
  --rule: #dbe0e7;
  --accent: #3043c4;
  --accent-soft: #e7eafc;
  --edge: #7b8594;
  --dot: #cfd5de;
  --warn: #8a5300;
  --warn-soft: #fff2d9;
  --sans: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0e1217;
    --surface: #161b22;
    --sunken: #11161c;
    --ink: #e4e8ee;
    --ink-2: #c3cad4;
    --muted: #939eac;
    --rule: #28303a;
    --accent: #95a3ff;
    --accent-soft: #202848;
    --edge: #6f7a88;
    --dot: #242c36;
    --warn: #f1b85a;
    --warn-soft: #2f2412;
    color-scheme: dark;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-padding-top: 16px; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font: 15px/1.55 var(--sans);
}
a { color: var(--accent); }
code, pre, .id { font-family: var(--mono); }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

.bar {
  display: flex; justify-content: space-between; gap: 16px;
  padding: 10px 24px; border-bottom: 1px solid var(--rule);
  color: var(--muted); font-size: 13px;
}
.bar { align-items: center; }
.bar > span:first-child, .bar .switch { flex: none; }
.switch select {
  font: 500 13.5px var(--mono); color: var(--ink); background: var(--surface);
  border: 1px solid var(--rule); border-radius: 6px; padding: 5px 8px; max-width: 60vw; cursor: pointer;
}
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.bar .path { font-family: var(--mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; direction: rtl; text-align: left; }

header.doc { padding: 36px 24px 28px; max-width: 1280px; margin: 0 auto; }
.title { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px 14px; }
.title h1 {
  margin: 0; font: 600 clamp(28px, 4.2vw, 40px)/1.1 var(--mono);
  letter-spacing: -0.02em; overflow-wrap: anywhere;
}
.title .ver { font: 500 18px var(--mono); color: var(--muted); }
.pill {
  display: inline-block; font-size: 12.5px; font-weight: 600; line-height: 1;
  padding: 5px 9px; border-radius: 999px; border: 1px solid var(--rule); color: var(--muted);
  align-self: center;
}
.pill.sealed { border-color: transparent; background: var(--accent-soft); color: var(--accent); }
.summary { margin: 12px 0 0; font-size: 17px; color: var(--ink-2); max-width: 68ch; }
dl.meta { display: flex; flex-wrap: wrap; gap: 8px 32px; margin: 22px 0 0; font-size: 13.5px; }
dl.meta div { min-width: 0; }
dl.meta dt { color: var(--muted); }
dl.meta dd { margin: 2px 0 0; font-family: var(--mono); overflow-wrap: anywhere; }
.warnings { margin: 20px 0 0; padding: 10px 14px; border-radius: 8px; background: var(--warn-soft); color: var(--warn); font-size: 13.5px; list-style: none; }
.warnings li { font-family: var(--mono); }

.layout {
  display: grid; grid-template-columns: minmax(280px, max-content) minmax(0, 1fr);
  gap: 28px; max-width: 1280px; margin: 0 auto; padding: 0 24px 64px; align-items: start;
}

aside.graph {
  position: sticky; top: 16px; max-height: calc(100vh - 32px); overflow: auto;
  background-color: var(--surface);
  background-image: radial-gradient(var(--dot) 1px, transparent 1.2px);
  background-size: 14px 14px;
  border: 1px solid var(--rule); border-radius: 12px; padding: 8px;
  max-width: 460px;
}
aside.graph .legend { display: flex; gap: 14px; flex-wrap: wrap; padding: 4px 10px 8px; font-size: 12px; color: var(--muted); }
aside.graph .legend span { display: inline-flex; align-items: center; gap: 6px; }
aside.graph .legend svg { flex: none; }
.fsm { display: block; max-width: 100%; height: auto; font-family: var(--mono); }
.fsm .box { fill: var(--surface); stroke: var(--ink-2); stroke-width: 1.3; transition: fill .15s, stroke .15s; }
.fsm .inner { fill: none; stroke: var(--ink-2); stroke-width: 1; }
.fsm .node text { font-size: 13px; fill: var(--ink); text-anchor: middle; pointer-events: none; }
.fsm .node { cursor: pointer; }
.fsm .node:hover .box { stroke: var(--accent); }
.fsm .node.unreached .box { stroke-dasharray: 4 3; }
.fsm .node.unreached text { fill: var(--muted); }
.fsm .node.current .box { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 2; }
.fsm .node.current .inner { stroke: var(--accent); }
.fsm .node.current text { fill: var(--accent); font-weight: 600; }
.fsm .edge { fill: none; stroke: var(--edge); stroke-width: 1.4; transition: stroke .15s; }
.fsm .edge.back { stroke-dasharray: 5 4; }
.fsm .edge.lit { stroke: var(--accent); stroke-width: 1.8; }
.fsm .arrowhead { fill: var(--edge); }
.fsm .entry { fill: var(--ink); }
.fsm .label { font-size: 11.5px; paint-order: stroke; stroke: var(--surface); stroke-width: 5px; stroke-linejoin: round; }
.fsm .label .outcome { fill: var(--ink); font-weight: 600; }
.fsm .label .policy { fill: var(--muted); font-size: 10.5px; }

main { min-width: 0; }
h2 { font-size: 19px; font-weight: 650; margin: 0 0 12px; letter-spacing: -0.01em; }
h2 .count { color: var(--muted); font-weight: 500; font-size: 15px; margin-left: 6px; }
.section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
button.toggle {
  font: 500 13px var(--sans); color: var(--accent); background: none; border: 0; padding: 4px 2px; cursor: pointer;
}
section + section { margin-top: 44px; }

.tasks { background: var(--surface); border: 1px solid var(--rule); border-radius: 12px; overflow: hidden; }
details.task { border-top: 1px solid var(--rule); scroll-margin-top: 16px; }
details.task:first-child { border-top: 0; }
details.task > summary {
  list-style: none; cursor: pointer; display: grid;
  grid-template-columns: 14px minmax(0, max-content) minmax(0, 1fr) auto; gap: 4px 12px; align-items: baseline;
  padding: 14px 18px; border-left: 3px solid transparent;
}
details.task > summary::-webkit-details-marker { display: none; }
details.task > summary::before {
  content: ""; width: 7px; height: 7px; border-right: 1.6px solid var(--muted); border-bottom: 1.6px solid var(--muted);
  transform: translateY(-2px) rotate(-45deg); transition: transform .15s; justify-self: center;
}
details.task[open] > summary::before { transform: translateY(-4px) rotate(45deg); }
details.task.current > summary { border-left-color: var(--accent); background: var(--sunken); }
.task .name { font: 600 15px var(--mono); overflow-wrap: anywhere; }
.task .name .v { font-weight: 400; color: var(--muted); margin-left: 8px; font-size: 13px; }
.task .brief { color: var(--muted); font-size: 14px; min-width: 0; }
.tags { display: flex; gap: 6px; }
.tag { font-size: 11.5px; font-weight: 600; padding: 2px 7px; border-radius: 5px; background: var(--sunken); color: var(--muted); border: 1px solid var(--rule); white-space: nowrap; }
.tag.start, .tag.end { color: var(--accent); background: var(--accent-soft); border-color: transparent; }
.tag.warn { color: var(--warn); background: var(--warn-soft); border-color: transparent; }

.task-body { padding: 4px 18px 22px 47px; }
.facts { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 20px; margin: 0 0 18px; font-size: 13.5px; }
.facts dt { color: var(--muted); }
.facts dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { font: 12.5px var(--mono); padding: 1px 7px; border-radius: 5px; border: 1px solid var(--rule); }
ul.next { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
ul.next li { font-family: var(--mono); font-size: 13px; }
ul.next .on { display: inline-block; min-width: 5ch; font-weight: 600; }
ul.next .arrow { color: var(--muted); margin: 0 6px; }
ul.next .policy { color: var(--muted); font-family: var(--sans); font-size: 12.5px; margin-left: 8px; }
.io { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin: 0 0 18px; }
.io h3, .prose-head { font-size: 12.5px; font-weight: 600; color: var(--muted); margin: 0 0 6px; }
pre { margin: 0; padding: 10px 12px; background: var(--sunken); border: 1px solid var(--rule); border-radius: 8px; font-size: 12.5px; line-height: 1.5; overflow-x: auto; }

.prose { border-left: 2px solid var(--rule); padding-left: 16px; max-width: 72ch; }
.prose > :first-child { margin-top: 0; }
.prose > :last-child { margin-bottom: 0; }
.prose h1 { font-size: 17px; margin: 0 0 8px; }
.prose h2 { font-size: 15.5px; margin: 18px 0 6px; }
.prose h3 { font-size: 14.5px; margin: 16px 0 6px; }
.prose p, .prose ul, .prose ol { margin: 0 0 10px; }
.prose code { font-size: .9em; background: var(--sunken); border: 1px solid var(--rule); border-radius: 4px; padding: 0 4px; }
.prose pre code { background: none; border: 0; padding: 0; }
.prose table { border-collapse: collapse; font-size: 13.5px; }
.prose th, .prose td { border: 1px solid var(--rule); padding: 4px 8px; text-align: left; }

table.servers { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--rule); border-radius: 12px; overflow: hidden; font-size: 13.5px; }
table.servers th { text-align: left; font-weight: 600; color: var(--muted); padding: 10px 14px; border-bottom: 1px solid var(--rule); background: var(--sunken); }
table.servers td { padding: 10px 14px; border-top: 1px solid var(--rule); vertical-align: top; overflow-wrap: anywhere; }
table.servers tr:first-child td { border-top: 0; }
table.servers td:first-child { font-family: var(--mono); font-weight: 600; }
.servers-wrap { overflow-x: auto; }

details.source > summary { cursor: pointer; color: var(--accent); font-size: 14px; font-weight: 500; }
details.source pre { margin-top: 12px; max-height: 70vh; }

footer { color: var(--muted); font-size: 12.5px; text-align: center; padding: 0 16px 32px; }

@media (max-width: 860px) {
  .bar, header.doc { padding-left: 16px; padding-right: 16px; }
  .layout { grid-template-columns: minmax(0, 1fr); padding: 0 16px 48px; gap: 24px; }
  aside.graph { position: static; max-height: none; max-width: none; }
  aside.graph .fsm { margin: 0 auto; }
  details.task > summary { grid-template-columns: 14px minmax(0, 1fr) auto; padding: 12px 14px; }
  details.task > summary .brief { grid-column: 2 / -1; }
  .task-body { padding: 4px 14px 20px 14px; }
}
@media (prefers-reduced-motion: reduce) {
  * { transition: none !important; scroll-behavior: auto !important; }
}
</style>
</head>
<body>
<div class="bar">
  {{if .Scope}}<label class="switch"><span class="visually-hidden">Workflow</span><select onchange="location.href = this.value">{{range .Scope}}<option value="{{.URL}}"{{if .Current}} selected{{end}}>{{.Label}}</option>{{end}}</select></label>{{else}}<span>awf render</span>{{end}}
  <span class="path" title="{{.Path}}"><bdi>{{.Path}}</bdi></span>
</div>

<header class="doc">
  <div class="title">
    <h1>{{.Name}}</h1>
    {{with .Version}}<span class="ver">{{.}}</span>{{end}}
    {{if .SHA}}<span class="pill sealed" title="{{.SHA}}">Sealed</span>{{else}}<span class="pill">Draft</span>{{end}}
  </div>
  {{with .Summary}}<p class="summary">{{.}}</p>{{end}}
  <dl class="meta">
    {{with .Model}}<div><dt>Model</dt><dd>{{.}}</dd></div>{{end}}
    {{with .Start}}<div><dt>Starts at</dt><dd><a href="#task-{{.}}">{{.}}</a></dd></div>{{end}}
    <div><dt>Sha</dt><dd>{{if .SHA}}{{.SHA}}{{else}}unsealed{{end}}</dd></div>
  </dl>
  {{with .Warnings}}<ul class="warnings" aria-label="Warnings">{{range .}}<li>{{.}}</li>{{end}}</ul>{{end}}
</header>

<div class="layout">
  <aside class="graph" aria-label="Orchestration">
    <div class="legend">
      <span><svg width="10" height="10" aria-hidden="true"><circle cx="5" cy="5" r="4" fill="currentColor"/></svg>start</span>
      <span><svg width="16" height="12" aria-hidden="true"><rect x=".5" y=".5" width="15" height="11" rx="3" fill="none" stroke="currentColor"/><rect x="3" y="3" width="10" height="6" rx="1.5" fill="none" stroke="currentColor"/></svg>ends the run</span>
      <span><svg width="22" height="10" aria-hidden="true"><path d="M1 5 H21" stroke="currentColor" stroke-dasharray="4 3"/></svg>loops back</span>
    </div>
    {{.Graph}}
  </aside>

  <main>
    <section>
      <div class="section-head">
        <h2>Tasks<span class="count">{{len .Tasks}}</span></h2>
        {{if gt (len .Tasks) 1}}<button class="toggle" type="button" data-collapse>Collapse all</button>{{end}}
      </div>
      <div class="tasks">
        {{range .Tasks}}
        <details class="task" id="task-{{.Name}}" data-task="{{.Name}}" open>
          <summary>
            <span class="name">{{.Name}}{{with .Version}}<span class="v">{{.}}</span>{{end}}</span>
            <span class="brief">{{.Summary}}</span>
            <span class="tags">
              {{if .Start}}<span class="tag start">start</span>{{end}}
              {{if .Terminal}}<span class="tag end">end</span>{{end}}
              {{if .Unreachable}}<span class="tag warn">unreachable</span>{{end}}
            </span>
          </summary>
          <div class="task-body">
            <dl class="facts">
              {{with .Model}}<dt>Model</dt><dd><code>{{.}}</code></dd>{{end}}
              <dt>Next</dt>
              <dd>
                {{if .Next}}
                <ul class="next">
                  {{range .Next}}
                  <li>{{if .On}}<span class="on">{{.On}}</span><span class="arrow">→</span>{{end}}<a href="#task-{{.To}}">{{.To}}</a>{{if or .Retries .Resume}}<span class="policy">{{with .Retries}}{{.}} retries{{end}}{{if and .Retries .Resume}}, {{end}}{{if .Resume}}resumes the session{{end}}</span>{{end}}</li>
                  {{end}}
                </ul>
                {{else}}Ends the run{{end}}
              </dd>
              {{with .Uses}}<dt>MCP</dt><dd class="chips">{{range .}}<a class="chip" href="#mcp-{{.}}">{{.}}</a>{{end}}</dd>{{end}}
              {{with .SHA}}<dt>Sha</dt><dd><code>{{.}}</code></dd>{{end}}
            </dl>
            {{if or .Input .Output}}
            <div class="io">
              {{with .Input}}<div><h3>Input</h3><pre><code>{{.}}</code></pre></div>{{end}}
              {{with .Output}}<div><h3>Output</h3><pre><code>{{.}}</code></pre></div>{{end}}
            </div>
            {{end}}
            {{with .Body}}<div class="prose">{{.}}</div>{{end}}
          </div>
        </details>
        {{end}}
      </div>
    </section>

    {{with .Servers}}
    <section>
      <h2>MCP servers<span class="count">{{len .}}</span></h2>
      <div class="servers-wrap">
      <table class="servers">
        <thead><tr><th>Name</th><th>Transport</th><th>Tools</th><th>Used by</th></tr></thead>
        <tbody>
          {{range .}}
          <tr id="mcp-{{.Name}}"><td>{{.Name}}</td><td>{{or .Transport "unspecified"}}</td><td>{{.Tools}}</td><td>{{range $i, $t := .UsedBy}}{{if $i}}, {{end}}<a href="#task-{{$t}}">{{$t}}</a>{{else}}<span style="color:var(--muted)">no task</span>{{end}}</td></tr>
          {{end}}
        </tbody>
      </table>
      </div>
    </section>
    {{end}}

    <section>
      <details class="source">
        <summary>Show source</summary>
        <pre><code>{{.Source}}</code></pre>
      </details>
    </section>
  </main>
</div>

<footer>Rendered by awf {{.CLI}}</footer>

<script>
(() => {
  const nodes = new Map([...document.querySelectorAll('.fsm .node')].map(n => [n.dataset.task, n]));
  const edges = [...document.querySelectorAll('.fsm .edge[data-from]')];
  const tasks = [...document.querySelectorAll('details.task')];
  let pinned = null;

  const focus = name => {
    tasks.forEach(t => t.classList.toggle('current', t.dataset.task === name));
    nodes.forEach((n, key) => n.classList.toggle('current', key === name));
    edges.forEach(e => e.classList.toggle('lit', e.dataset.from === name));
  };

  nodes.forEach((n, name) => n.addEventListener('click', ev => {
    ev.preventDefault();
    const t = document.getElementById('task-' + name);
    if (!t) return;
    t.open = true;
    history.replaceState(null, '', '#task-' + name);
    t.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    pinned = name;
    focus(name);
  }));

  // The current task is the last one whose header has scrolled past the top.
  // A clicked node stays current until the reader scrolls on their own, since
  // the last tasks cannot always scroll up to the top.
  const spy = () => {
    if (pinned) return;
    let current = tasks[0];
    for (const t of tasks) if (t.getBoundingClientRect().top <= 96) current = t;
    if (current) focus(current.dataset.task);
  };
  if (nodes.size) {
    let queued = false;
    addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; spy(); });
    }, { passive: true });
    ['wheel', 'touchstart', 'keydown'].forEach(type => addEventListener(type, () => { pinned = null; }, { passive: true }));
    spy();
  }

  const toggle = document.querySelector('[data-collapse]');
  if (toggle) toggle.addEventListener('click', () => {
    const open = tasks.some(t => t.open);
    tasks.forEach(t => { t.open = !open; });
    toggle.textContent = open ? 'Expand all' : 'Collapse all';
  });

  if (location.hash.startsWith('#task-')) {
    pinned = decodeURIComponent(location.hash.slice(6));
    focus(pinned);
  }
})();
</script>
</body>
</html>
